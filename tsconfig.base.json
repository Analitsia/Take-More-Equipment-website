{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    // Shared packages are consumed as TypeScript source (no build step), and
    // their relative imports carry explicit .ts extensions so plain `node` can
    // run them too — which is what lets the test harnesses in packages/*/tests
    // import the real domain rules instead of a copy. Safe with noEmit.
    "allowImportingTsExtensions": true
  }
}
