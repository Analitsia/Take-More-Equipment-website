# Take More — environment variables
#
# Names only. No values live in this file and none ever should: it is committed,
# and `.env.local` (which is not) is where the real ones go.
#
# `scripts/check-launch-ready.mjs` asserts that every `process.env.X` read
# anywhere in apps/ or packages/ appears below, so adding a variable to the code
# without documenting it here fails CI. That is the point of the file.
#
# Copy to .env.local and fill in:  cp .env.example .env.local

# ── Supabase ────────────────────────────────────────────────────────────────
# From the project's API settings. New-format keys (`sb_publishable_…`,
# `sb_secret_…`), not the legacy anon/service_role pair.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS entirely. Server only. Never in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Management API — migrations, type generation and the parity suite. Not needed
# at runtime by either app.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ── The two apps pointing at each other ─────────────────────────────────────
# The storefront's public URL. NEXT_PUBLIC_ so client components can build links
# with it; the unprefixed one is the server-side fallback.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3000

# Shared secret ops uses to ask the storefront to revalidate a page, and an
# accepted fallback credential for a manual /api/match run.
REVALIDATE_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Until RESEND_API_KEY exists, ops sends nothing by email and says so in the UI;
# the one-tap WhatsApp queue still works. Put marketing on its own subdomain so
# a newsletter complaint cannot damage transactional deliverability.
RESEND_API_KEY=
RESEND_MARKETING_FROM="Take More <stock@news.takemoreequipment.co.za>"
RESEND_REPLY_TO=

# The postal address in the footer of every marketing email. A physical address
# is what makes a commercial sender identifiable — POPIA s69 and every major
# mailbox provider's bulk-sender guidance both expect one.
#
# It must agree with contact.legalName and contact.address in
# apps/web/src/data/launch.ts. It is a variable rather than an import because
# the ops app cannot reach the storefront's launch manifest; docs/launch-checklist.md
# lists the two together so they cannot be updated apart.
BUSINESS_POSTAL_IDENTITY="Take More Catering Equipment (Pty) Ltd, Montague Gardens, Cape Town"

# ── The nightly stock-match cron ────────────────────────────────────────────
# Vercel sets this itself when the cron in apps/ops/vercel.json is registered.
# With neither this nor REVALIDATE_SECRET set, /api/match refuses every caller.
CRON_SECRET=

# ── Bot protection (Cloudflare Turnstile) ───────────────────────────────────
# Free. Both keys are needed on BOTH Vercel projects.
#
# Unset in production, the enquiry form and the staff access-request form both
# refuse — deliberately, so an unprotected form cannot ship silently. Unset
# anywhere else they pass, so local dev and CI keep working.
#
# The values below are Cloudflare's documented always-passes test keys. Fine for
# local work; replace with real ones before the domain is pointed here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Any long random string. Salts the hash of a requester's IP so the database
# stores a fingerprint and never an address — an IP is personal information
# under POPIA. Changing it resets the per-IP throttle; that is all it does.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_REQUEST_IP_PEPPER=

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
# Entirely optional. With no DSN the SDK never initialises, reportError() falls
# back to console.error, and nothing else changes.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time only. Absent = maps are not uploaded and the
# build still succeeds, which is what keeps the no-secret CI build green.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Test harnesses ──────────────────────────────────────────────────────────
# Which ops deployment `npm run test:pages` drives. Defaults to localhost:3001.
OPS_URL=http://localhost:3001
